{
  "manifest_version": 3,
  "name": "Fishy",
  "description": "Tells you if the email you're reading looks like phishing or a scam.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.ts"]
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.typesafe.ai/*"]
}
